## Copy this file to local.properties and complete the values for your machine.
## Do not commit the real local.properties file.

sdk.dir=C\:\\Android\\Sdk

meteoblue.apiKey=

## Gemini API is used by the assistant when the device is online.
## You can also set these as GEMINI_API_KEY / GEMINI_MODEL environment variables before building.
gemini.apiKey=
gemini.model=gemini-2.5-flash
gemini.maxOutputTokens=2048

## Map engine.
## Online map source: https://maps.scouty.app/base/romania-high-detail.pmtiles by default.
## Offline trail packs are downloaded automatically from:
## https://maps.scouty.app/trails/{trailCode}/manifest.json
maps.baseUrl=https://maps.scouty.app
